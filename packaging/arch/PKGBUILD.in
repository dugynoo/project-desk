# Generated by scripts/build-arch.sh from the release's Debian payload.
pkgname=project-desk-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Desktop workspace for Claude Code, Codex, Antigravity and shell sessions'
arch=('x86_64')
url='https://github.com/dugynoo/project-desk'
license=('MIT')
depends=('glibc' 'gtk3' 'webkit2gtk-4.1' 'libsoup3' 'openssl' 'hicolor-icon-theme' 'xdg-utils')
optdepends=('nodejs: Antigravity hook relay' 'xdg-desktop-portal: desktop file dialogs')
provides=('project-desk')
conflicts=('project-desk')
options=('!strip' '!debug')
source=('project-desk.deb' 'LICENSE')
noextract=('project-desk.deb')
sha256sums=('@DEB_SHA256@' '@LICENSE_SHA256@')

package() {
  # bsdtar handles both the ar container and compressed data archive.
  local payload
  payload=$(bsdtar -tf "$srcdir/project-desk.deb" | grep -E '^data\.tar\.(gz|xz|zst)$')
  test -n "$payload"
  bsdtar -xOf "$srcdir/project-desk.deb" "$payload" | bsdtar -xf - -C "$pkgdir"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
